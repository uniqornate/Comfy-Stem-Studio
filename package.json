{
  "name": "stem-studio",
  "version": "0.12.31",
  "private": true,
  "description": "Local video soundtrack cleanup powered by ComfyUI",
  "author": "Stem Studio contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "dist:win": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File build/package-quiet-process.ps1 && electron-builder --win nsis --x64 && powershell -NoProfile -ExecutionPolicy Bypass -File build/package-setup.ps1",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@comfyorg/sdk": "0.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.8.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "studio.stem.desktop",
    "productName": "Stem Studio",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "setup",
        "to": "setup"
      },
      {
        "from": "comfy_nodes",
        "to": "comfy_nodes"
      }
    ],
    "files": [
      "src/clip-edits.mjs",
      "src/sam-guidance.mjs",
      "setup/quiet-process.mjs",
      "setup/download-verified.mjs",
      "setup/comfy-install.mjs",
      "setup/status-writer.mjs",
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Stem-Studio-Core.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false
    }
  }
}
